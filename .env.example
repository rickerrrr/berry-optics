# Berry Optics Website - Environment Variables
# Copy to .env.local and configure

# Hermes Backend (AI Assistant)
# Server-side (Vercel deployment — used by /api/ai route)
HERMES_BACKEND_URL=http://127.0.0.1:61364
HERMES_MODEL=doubao-seed-2-1-pro-260628

# Client-side (Static export — used by AI widget directly)
# Only needed for CloudStudio static deployment
NEXT_PUBLIC_HERMES_URL=http://127.0.0.1:61364
NEXT_PUBLIC_HERMES_MODEL=doubao-seed-2-1-pro-260628

# Site
NEXT_PUBLIC_SITE_URL=https://www.berryoptics.com
